{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://megazord.local/models/registry.schema.json",
  "title": "Megazord Model Registry",
  "description": "ISA-95 compliant model registry for LLM cluster management",
  "type": "object",
  "required": ["version", "models"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tag_prefix": {
      "type": "string",
      "description": "ISA-95 tag prefix for models"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/UDT_Model"
      }
    }
  },
  "definitions": {
    "UDT_Model": {
      "type": "object",
      "description": "User Defined Type for LLM Model (ISA-88 compliant)",
      "required": ["id", "name", "vram_mb"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique model identifier (used for M() hash)",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable model name"
        },
        "family": {
          "type": "string",
          "description": "Model family (llama, mistral, phi, etc.)"
        },
        "params": {
          "type": "string",
          "description": "Parameter count (7B, 70B, etc.)"
        },
        "vram_mb": {
          "type": "integer",
          "minimum": 0,
          "description": "VRAM requirement in MB"
        },
        "quant": {
          "type": "string",
          "enum": ["fp32", "fp16", "bf16", "int8", "int4", "gguf"],
          "description": "Quantization format"
        },
        "shard": {
          "type": "boolean",
          "description": "Can be sharded across multiple GPUs"
        },
        "context_len": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum context length in tokens"
        },
        "source": {
          "type": "string",
          "description": "HuggingFace model ID or download source"
        },
        "path": {
          "type": ["string", "null"],
          "description": "Local path if downloaded"
        },
        "loaded": {
          "type": "boolean",
          "description": "Currently loaded on GPU(s)"
        },
        "on_gpus": {
          "type": "array",
          "items": {"type": "string"},
          "description": "GPU hashes where model is loaded"
        }
      }
    }
  }
}
